# Generate a strong key, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False

# The stack is expected to sit behind the host-level nginx (TLS on the
# subdomain, proxying to 127.0.0.1:HTTP_PORT). Keep this True when the public
# URL is HTTPS: it enables secure cookies, HSTS and SSL redirect.
DJANGO_HTTPS=True

# The public subdomain must be listed here and in CSRF_TRUSTED_ORIGINS.
ALLOWED_HOSTS=okid.example.com
CSRF_TRUSTED_ORIGINS=https://okid.example.com
CORS_ALLOWED_ORIGINS=https://okid.example.com

# Local loopback port where the frontend container is published. Must differ
# from the ports used by the main nginx (80/443).
HTTP_PORT=8080

DATABASE_HOST=db
DATABASE_PORT=5432
POSTGRES_DB=okid
POSTGRES_USER=okid
POSTGRES_PASSWORD=
POISKKINO_API_KEY=
SHIKIMORI_APP_NAME=
